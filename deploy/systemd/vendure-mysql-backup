#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly vendure_repo_dir="${VENDURE_REPO_DIR:-/var/www/kaiyuangouwu}"
readonly vendure_env_file="${VENDURE_ENV_FILE:-${vendure_repo_dir}/packages/dev-server/.env}"
readonly vendure_backup_dir="${VENDURE_BACKUP_DIR:-/var/backups/vendure-mysql}"

if [[ ! -r "${vendure_env_file}" ]]; then
    printf 'Production environment file is not readable: %s\n' "${vendure_env_file}" >&2
    exit 1
fi

set -a
# shellcheck disable=SC1090
source "${vendure_env_file}"
set +a

readonly offsite_backup_required="${VENDURE_REQUIRE_OFFSITE_BACKUP:-false}"
readonly offsite_backup_uri="${VENDURE_BACKUP_S3_URI:-}"
readonly offsite_retention_days="${VENDURE_DATABASE_BACKUP_S3_RETENTION_DAYS:-30}"

if [[ ! "${offsite_backup_required}" =~ ^(true|false)$ ]]; then
    printf 'VENDURE_REQUIRE_OFFSITE_BACKUP must be true or false\n' >&2
    exit 1
fi

for required_name in DB_HOST DB_PORT DB_USERNAME DB_PASSWORD DB_NAME; do
    if [[ -z "${!required_name:-}" ]]; then
        printf 'Required database setting is missing: %s\n' "${required_name}" >&2
        exit 1
    fi
done

if [[ "${offsite_backup_required}" == "true" && -z "${offsite_backup_uri}" ]]; then
    printf 'VENDURE_BACKUP_S3_URI is required when offsite backups are mandatory\n' >&2
    exit 1
fi
if [[ -n "${offsite_backup_uri}" && ! "${offsite_backup_uri}" =~ ^s3://[a-z0-9.-]+(/[A-Za-z0-9._/-]+)?$ ]]; then
    printf 'VENDURE_BACKUP_S3_URI must be a safe s3:// bucket prefix\n' >&2
    exit 1
fi
if [[ ! "${offsite_retention_days}" =~ ^[0-9]+$ ]] ||
    ((offsite_retention_days < 7 || offsite_retention_days > 365)); then
    printf 'VENDURE_DATABASE_BACKUP_S3_RETENTION_DAYS must be between 7 and 365\n' >&2
    exit 1
fi

install -d -m 0700 "${vendure_backup_dir}"
if ! command -v flock >/dev/null 2>&1; then
    printf 'The existing production flock utility is required for backup serialization\n' >&2
    exit 1
fi
exec 8>"${vendure_backup_dir}/.backup.lock"
if ! flock --nonblock 8; then
    printf 'Another MySQL backup is already running\n' >&2
    exit 1
fi

readonly backup_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
readonly backup_file="${vendure_backup_dir}/vendure-${backup_stamp}.sql.gz"
readonly backup_partial="${backup_file}.part"
if [[ -e "${backup_file}" || -e "${backup_partial}" || -e "${backup_file}.manifest.json" ]]; then
    printf 'Refusing to overwrite an existing backup with the same timestamp\n' >&2
    exit 1
fi

preserve_failed_backup() {
    if [[ -f "${backup_partial}" ]]; then
        mv "${backup_partial}" "${backup_partial}.failed"
    fi
    if [[ -f "${backup_partial}.manifest.json" ]]; then
        mv "${backup_partial}.manifest.json" "${backup_partial}.manifest.json.failed"
    fi
    if [[ -f "${backup_file}.sha256.part" ]]; then
        mv "${backup_file}.sha256.part" "${backup_file}.sha256.part.failed"
    fi
}
trap preserve_failed_backup EXIT

# One MVCC read snapshot covers both the export and its row manifest.
# The DDL-only backup lock permits business writes. Timeout closes the snapshot and releases the lock.
readonly manifest_tool="$(dirname "$(readlink -f "$0")")/vendure-mysql-backup-manifest.py"
readonly s3_policy_guard="$(dirname "$(readlink -f "$0")")/vendure-backup-s3-guard.py"
timeout --kill-after=5s 15m python3 "${manifest_tool}" capture "${backup_partial}"

gzip -t "${backup_partial}"
mv "${backup_partial}.manifest.json" "${backup_file}.manifest.json"
mv "${backup_partial}" "${backup_file}"
(
    cd "${vendure_backup_dir}"
    sha256sum "$(basename "${backup_file}")" "$(basename "${backup_file}.manifest.json")" > "$(basename "${backup_file}.sha256.part")"
)
mv "${backup_file}.sha256.part" "${backup_file}.sha256"

if [[ -n "${offsite_backup_uri}" ]]; then
    if ! command -v aws >/dev/null 2>&1; then
        printf 'AWS CLI is required to upload the offsite backup\n' >&2
        exit 1
    fi
    python3 "${s3_policy_guard}" "${offsite_backup_uri}" "${offsite_retention_days}" >/dev/null
    readonly offsite_prefix="${offsite_backup_uri%/}"
    readonly bucket_and_prefix="${offsite_prefix#s3://}"
    readonly bucket="${bucket_and_prefix%%/*}"
    prefix="${bucket_and_prefix#${bucket}}"
    prefix="${prefix#/}"
    for source in "${backup_file}" "${backup_file}.manifest.json" "${backup_file}.sha256"; do
        name="$(basename "${source}")"
        key="${name}"
        if [[ -n "${prefix}" ]]; then key="${prefix}/${name}"; fi
        aws s3 cp "${source}" "s3://${bucket}/${key}" --sse AES256 --only-show-errors
        [[ "$(aws s3api head-object --bucket "${bucket}" --key "${key}" --query ServerSideEncryption --output text)" == "AES256" ]]
    done
fi
trap - EXIT

printf 'Created verified MySQL backup: %s offsite=%s encrypted=%s\n' \
    "${backup_file}" "$([[ -n "${offsite_backup_uri}" ]] && printf yes || printf no)" \
    "$([[ -n "${offsite_backup_uri}" ]] && printf yes || printf local-volume)"
