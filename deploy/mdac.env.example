# Local integration candidate. Do not apply to production without a release.
# Only this verified ACTIVE domain's Channel may enable mdac-entry.
# Missing/invalid policy disables the feature for every Channel.
STOREFRONT_MDAC_ALLOWED_DOMAIN=damatong.net

# Customer-initiated submission to the official MDAC form.
# The worker only runs when this is exactly "true"; the shop API still returns
# a clear message and the storefront keeps the manual official link visible.
STOREFRONT_MDAC_SUBMIT_ENABLED=false

# Fill the official form and solve its slider, but stop before Submit.
# Enable this first on a real server, run one traveller, compare the captured
# page, then switch it off.
STOREFRONT_MDAC_SUBMIT_DRY_RUN=true

# Job store. Holds one JSON record per traveller plus the receipt PDF.
STOREFRONT_MDAC_SUBMIT_DIR=/var/lib/damatong/mdac-submissions

# Optional outbound proxy (http://user:pass@host:port). The official site rates
# limits per client, so spread submissions instead of hammering one address.
STOREFRONT_MDAC_SUBMIT_PROXY=

# Set to "chrome" to drive the installed Chrome instead of the bundled Chromium.
STOREFRONT_MDAC_SUBMIT_CHANNEL=

# Visible browser is useful on a desktop server while diagnosing a selector
# change. Keep true in production.
STOREFRONT_MDAC_SUBMIT_HEADLESS=true

# Worker poll interval in milliseconds.
STOREFRONT_MDAC_SUBMIT_INTERVAL_MS=20000
