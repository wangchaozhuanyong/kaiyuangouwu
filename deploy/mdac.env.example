# Example for a runtime outside the managed production PM2 configuration.
# Only this verified ACTIVE domain's Channel may enable mdac-entry.
# Missing/invalid policy disables the feature for every Channel.
STOREFRONT_MDAC_ALLOWED_DOMAIN=damatong.net

# Server-side OAG Flight Info v2 key for a plan authorizing customer display and Status data.
# Enable explicitly only after the authorized subscription is available and tested.
STOREFRONT_MDAC_FLIGHT_LOOKUP_ENABLED=false
# Never expose the key to Vite.
STOREFRONT_MDAC_OAG_SUBSCRIPTION_KEY=
