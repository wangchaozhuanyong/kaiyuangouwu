{
    "name": "vendure",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "homepage": "https://www.vendure.io",
    "repository": {
        "type": "git",
        "url": "https://github.com/vendurehq/vendure"
    },
    "scripts": {
        "watch": "lerna run watch --parallel",
        "watch:core-common": "lerna run --scope @vendure/common --scope @vendure/core watch --parallel",
        "build:core-common": "lerna run --scope @vendure/common --scope @vendure/core build",
        "sync:storefront-media": "bun run --cwd packages/dev-server sync:storefront-media",
        "sync:homepage-carousel": "bun run --cwd packages/dev-server sync:homepage-carousel",
        "sync:auth-visuals": "bun run --cwd packages/dev-server sync:auth-visuals",
        "sync:moyao-brand": "bun run --cwd packages/dev-server sync:moyao-brand",
        "sync:damatong-storefront": "bun run --cwd packages/dev-server sync:damatong-storefront",
        "repair:inventory-inheritance": "bun run --cwd packages/dev-server repair:inventory-inheritance",
        "lint": "eslint --fix",
        "lint:check": "node scripts/lint-check.mjs",
        "format": "prettier --write --html-whitespace-sensitivity ignore",
        "docs:generate-typescript-docs": "ts-node scripts/docs/generate-typescript-docs.ts",
        "docs:generate-graphql-docs": "ts-node scripts/docs/generate-graphql-docs.ts --api=shop && ts-node scripts/docs/generate-graphql-docs.ts --api=admin",
        "docs:build": "bun run docs:generate-typescript-docs && bun run docs:generate-graphql-docs",
        "codegen": "tsc -p scripts/codegen/plugins && ts-node scripts/codegen/generate-graphql-types.ts && bun run codegen:gql-tada",
        "codegen:gql-tada": "ts-node scripts/codegen/generate-gql-tada-types.ts",
        "version": "bun install && bun run check-imports && bun run check-angular-versions && bun run build && bun run check-core-type-defs && bun run generate-changelog && git add CHANGELOG* && git add */version.ts && git add bun.lock",
        "test": "lerna run test --stream --no-bail",
        "e2e": "lerna run e2e --stream --no-bail",
        "build": "lerna run build",
        "check-imports": "ts-node scripts/check-imports.ts",
        "check:migration-registry": "node scripts/check-migration-registry.mjs",
        "audit:architecture-debt": "node scripts/architecture-debt-audit.mjs",
        "check:architecture-debt": "node scripts/architecture-debt-audit.mjs --check",
        "check:storefront-publishing": "node scripts/check-storefront-publishing-policy.mjs",
        "test:repository-checks": "node --test scripts/architecture-debt-audit.spec.mjs scripts/check-migration-registry.spec.mjs scripts/check-storefront-publishing-policy.spec.mjs",
        "check-core-type-defs": "ts-node scripts/check-core-type-defs.ts",
        "check-angular-versions": "ts-node scripts/check-angular-versions.ts",
        "generate-changelog": "ts-node scripts/changelogs/generate-changelog.ts",
        "publish-release": "lerna version -m \"chore: Publish %s\" --no-push --force-publish --exact",
        "publish-prerelease": "lerna version -m \"chore: Pre-release %s\" prerelease --exact --no-push --force-publish --preid next --dist-tag next",
        "publish-local": "lerna version --force-publish --no-git-tag-version && cd scripts && ./publish-to-verdaccio.sh"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.1.0",
        "@commitlint/config-conventional": "^19.1.0",
        "@gql.tada/cli-utils": "^1.6.5",
        "@graphql-codegen/add": "6.0.0",
        "@graphql-codegen/cli": "6.0.0",
        "@graphql-codegen/fragment-matcher": "6.0.0",
        "@graphql-codegen/typed-document-node": "^6.0.1",
        "@graphql-codegen/typescript": "5.0.1",
        "@graphql-codegen/typescript-operations": "5.0.1",
        "@graphql-tools/schema": "^10.0.25",
        "@swc/core": "1.16.0",
        "@types/node": "^20.11.19",
        "@types/nodemailer": "^8.0.1",
        "@typescript-eslint/eslint-plugin": "8.67.0",
        "@typescript-eslint/parser": "8.67.0",
        "@vendure-io/docs-generator": "^0.1.1",
        "concurrently": "^9.2.0",
        "conventional-changelog-core": "^7.0.0",
        "cross-env": "^7.0.3",
        "eslint": "8.57.1",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-jsdoc": "^45.0.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "find": "^0.3.0",
        "gql.tada": "^1.8.10",
        "graphql": "^16.11.0",
        "husky": "^4.3.0",
        "lerna": "10.0.0",
        "lint-staged": "^10.5.4",
        "prettier": "^3.2.5",
        "prettier-plugin-organize-imports": "^4.1.0",
        "rollup": "^4.18.0",
        "tinybench": "^2.6.0",
        "ts-node": "^10.9.2",
        "typescript": "5.9.3",
        "unplugin-swc": "^1.4.4",
        "vite": "^7.3.6",
        "vitest": "^3.2.4"
    },
    "//": "Fix for https://github.com/npm/cli/issues/4828",
    "optionalDependencies": {
        "@nx/nx-darwin-arm64": "23.1.1",
        "@nx/nx-darwin-x64": "23.1.1",
        "@nx/nx-linux-x64-gnu": "23.1.1",
        "@nx/nx-win32-x64-msvc": "23.1.1",
        "@rollup/rollup-linux-x64-gnu": "^4.13.0",
        "@swc/core-darwin-arm64": "1.16.0",
        "@swc/core-linux-x64-gnu": "1.16.0"
    },
    "//overrides": "Force one GraphQL version to prevent TS2742, and pin compatible patched transitive dependencies until their parents update.",
    "overrides": {
        "@apollo/server": "5.5.0",
        "@babel/core": "7.29.7",
        "@babel/plugin-transform-modules-systemjs": "7.29.8",
        "@grpc/grpc-js": "1.14.4",
        "@hono/node-server": "1.19.17",
        "@isaacs/brace-expansion": "5.0.1",
        "brace-expansion": "5.0.9",
        "@nestjs/common": "11.2.1",
        "@nestjs/core": "11.2.1",
        "@nestjs/apollo": "13.4.4",
        "@nestjs/graphql": "13.4.4",
        "@nestjs/platform-express": "11.2.1",
        "@nestjs/testing": "11.2.1",
        "@opentelemetry/core": "2.9.0",
        "@opentelemetry/exporter-prometheus": "0.220.0",
        "@opentelemetry/propagator-jaeger": "2.9.0",
        "@opentelemetry/sdk-node": "0.220.0",
        "@protobufjs/utf8": "1.1.2",
        "@sigstore/core": "3.2.1",
        "@sigstore/verify": "3.1.1",
        "@tiptap/extension-bubble-menu": "3.30.4",
        "axios": "1.18.0",
        "engine.io": "6.6.9",
        "fast-uri": "3.1.6",
        "fast-xml-parser": "5.7.0",
        "file-type": "21.3.4",
        "flatted": "3.4.4",
        "follow-redirects": "1.16.0",
        "form-data": "4.0.6",
        "graphql": "^16.11.0",
        "handlebars": "4.7.9",
        "hono": "4.12.34",
        "http-proxy-middleware": "3.0.7",
        "immutable": "5.1.8",
        "ip-address": "10.5.0",
        "js-beautify": "2.0.3",
        "js-cookie": "3.0.8",
        "js-yaml": "4.3.1",
        "less": "4.9.0",
        "linkify-it": "5.0.2",
        "lodash": "4.18.1",
        "markdown-it": "14.3.0",
        "multer": "2.2.0",
        "nanoid": "3.3.18",
        "node-forge": "1.4.0",
        "esbuild": "0.28.2",
        "nx": "23.1.1",
        "pacote": "21.5.1",
        "piscina": "4.9.3",
        "postcss": "8.5.26",
        "protobufjs": "7.6.5",
        "qs": "6.15.2",
        "rollup": "4.62.4",
        "serialize-javascript": "7.1.0",
        "seroval": "1.5.3",
        "sharp": "0.35.3",
        "sigstore": "4.1.1",
        "shell-quote": "1.10.0",
        "socket.io-adapter": "2.5.8",
        "socket.io-parser": "4.2.7",
        "svgo": "4.0.2",
        "tar": "7.5.22",
        "tmp": "0.2.7",
        "typeorm": "0.3.31",
        "undici": "6.28.0",
        "uuid": "11.1.1",
        "vite": "7.3.6",
        "websocket-driver": "0.7.5",
        "webpack": "5.105.0",
        "webpack-dev-server": "5.2.6"
    },
    "trustedDependencies": [
        "husky",
        "better-sqlite3"
    ],
    "workspaces": [
        "packages/*"
    ],
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
            "subject-case": [
                2,
                "always",
                [
                    "sentence-case"
                ]
            ]
        }
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS",
            "post-commit": "git update-index --again",
            "pre-commit": "NODE_OPTIONS=\"--max-old-space-size=8096\" lint-staged"
        }
    },
    "patchedDependencies": {
        "husky@4.3.8": "patches/husky@4.3.8.patch",
        "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch",
        "qs@6.15.2": "patches/qs@6.15.2.patch"
    }
}
