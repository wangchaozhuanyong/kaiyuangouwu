# Public DNS target merchants point their CNAME or ALIAS records to.
STORE_DOMAIN_CNAME_TARGET=stores.example.com

# Use require-domain in production so unknown hosts never fall back to another store.
STORE_DOMAIN_ROUTING_MODE=prefer-domain

# Enable only when a trusted ingress always overwrites x-forwarded-host.
STORE_DOMAIN_TRUST_PROXY=false

# Hosts which retain normal vendure-token routing for local or internal access.
STORE_DOMAIN_BYPASS_HOSTS=localhost,127.0.0.1,vendure.localhost
