# Runtime and API
NODE_ENV=development
# Production must explicitly choose managed-services or single-host.
PRODUCTION_DEPLOYMENT_PROFILE=single-host
# A hardened single-host deployment may use system monitoring instead of OTEL export.
PRODUCTION_OBSERVABILITY_MODE=system
# All stores use Beijing business time. Database timestamps remain UTC.
TZ=Asia/Shanghai
VENDURE_HOSTNAME=127.0.0.1
PORT=3000
# Release-time media sync target. This can be an internal API origin in production.
VENDURE_API_ORIGIN=http://127.0.0.1:3000
# Comma-separated Channels whose products and managed storefront content receive the release assets.
STOREFRONT_MEDIA_CHANNEL_CODES=cn-mainland
# Set to 1 when Nginx is the only reverse proxy in front of Vendure.
VENDURE_TRUST_PROXY=false
VENDURE_SERVE_GRAPHIQL=true
# Production GraphQL query-complexity ceiling. Tune only after measuring real queries.
VENDURE_MAX_QUERY_COMPLEXITY=1000
# Google Cloud Translation Basic v2 key. Production readiness blocks release without it.
# Restrict this key to the Cloud Translation API and to the production server's network identity.
VENDURE_GOOGLE_TRANSLATION_API_KEY=
VENDURE_SERVE_STATIC_DASHBOARD=true
VENDURE_DASHBOARD_URL=http://localhost:3000/dashboard
# Fallback for account emails when a Channel does not yet have a verified primary domain.
VENDURE_STOREFRONT_URL=http://127.0.0.1:5175
VENDURE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RUN_JOB_QUEUE=1
RUN_MIGRATIONS=true

# Internal Telegram notifications. Use one private group and keep the Bot Token server-only.
# Chat IDs are strings and private group IDs commonly start with -100.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
# Optional emergency DB-down direct notification when the saved configuration cannot be read.
TELEGRAM_EMERGENCY_ENABLED=false

# Production backup policy. Set true only with a writeable s3:// destination and instance-role access.
VENDURE_REQUIRE_OFFSITE_BACKUP=false
VENDURE_BACKUP_S3_URI=

# Authentication. Production startup rejects defaults, placeholders, and weak secrets.
SUPERADMIN_USERNAME=replace-with-a-non-default-admin-identifier
SUPERADMIN_PASSWORD=replace-with-a-strong-password
COOKIE_SECRET=replace-with-a-long-random-secret
# One-time reviewed inventory repair targets. Keep empty outside the repair release shell.
INVENTORY_REPAIR_CHANNEL_CODES=
INVENTORY_INHERIT_SKUS=
# HMAC secret shared by short-lived checkout results and signed digital-delivery email entries.
ORDER_CONFIRMATION_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Secure digital-delivery entry sent by email. Default: 7 days; allowed: 60 seconds to 30 days.
ORDER_CONFIRMATION_EMAIL_TOKEN_TTL_SECONDS=604800

# Legacy global USDT-TRC20 receiving address. It is imported into Channel wallets on first startup.
# Leave empty for new installations and submit each Channel address from Dashboard instead.
STOREFRONT_USDT_TRC20_RECEIVING_ADDRESS=
# SHA-256 of `storefront-usdt-wallet:v1:<address>`; required in production when the address is set.
# Generate it offline and keep it under a separate deployment review from the receiving address.
STOREFRONT_USDT_TRC20_ADDRESS_SHA256=
# Server-only HMAC secret used to authorize automatic Vendure payment settlement.
USDT_PAYMENT_PROOF_SECRET=replace-with-a-random-secret-at-least-32-characters
# Independent AES-256-GCM key used to encrypt Channel wallet addresses at rest.
USDT_WALLET_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional comma-separated previous keys retained only during reviewed rotation; do not repeat any current secret.
USDT_WALLET_ENCRYPTION_PREVIOUS_KEYS=
# Optional comma-separated, reviewed TRON wallets allowed to send manually registered USDT refunds.
# Leave empty to disable manual USDT refund registration; restart API and Worker after changing it.
USDT_REFUND_SENDER_ADDRESSES=
# Optional but recommended TronGrid read-only API key for stable rate limits.
TRONGRID_API_KEY=

# Optional short-video promotion page. Keep the production gate false so the main domain opens directly.
# The random secret is still required because promotion links and referral payments use signed proofs.
STOREFRONT_PROMOTION_GATE_ENABLED=false
STOREFRONT_ENTRY_SECRET=replace-with-a-random-secret-at-least-32-characters

# Database. Development may use true; production must use false after initial creation.
DB=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=vendure-dev
DB_SYNCHRONIZE=true

# Persistent application data
# Development may use these relative paths. Production requires absolute paths mounted on persistent storage.
VENDURE_ASSET_UPLOAD_DIR=./assets
VENDURE_IMPORT_ASSETS_DIR=./import-assets
VENDURE_EMAIL_OUTPUT_DIR=./test-emails

# Protected digital delivery files. Name files by SKU, e.g. DEMO-DIGITAL-PROMPTS.zip.
# Production requires an absolute persistent path and a random secret of at least 32 characters.
DIGITAL_DELIVERY_ROOT=./digital-delivery-assets
DIGITAL_DELIVERY_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
DIGITAL_DELIVERY_LINK_TTL_SECONDS=300

# Encrypts credential-pool account, password, phone and 2FA fields at rest.
# Production requires a non-placeholder secret of at least 32 characters. Keep the same value across API and worker.
AUTO_CARD_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# Encrypts management-dashboard 2FA account secrets at rest in the database.
# Production requires a non-placeholder secret of at least 32 characters. Keep the same value across API and worker.
TWO_FACTOR_DASHBOARD_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# Private AI image storage and secrets. Keep identical values on API and worker processes.
# Production requires an absolute persistent directory and non-placeholder secrets of at least 32 characters.
IMAGE_GENERATION_STORAGE_ROOT=./image-generation-private
IMAGE_GENERATION_DOWNLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
IMAGE_GENERATION_MASTER_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional, comma-separated exact hostnames allowed when a relay returns an image URL instead of inline bytes.
# Leave empty when all configured relays return base64/inline image data.
IMAGE_GENERATION_REMOTE_IMAGE_HOSTS=
# Optional. When true, only a newly deployed and build-validated prompt Skill bundle is promoted automatically.
# Historical bundles remain available for rollback. Existing bundles are not re-promoted by an old process restart.
IMAGE_PROMPT_SKILL_AUTO_ACTIVATE=false

# Email. Development writes messages to VENDURE_EMAIL_OUTPUT_DIR.
# Production uses Resend SMTP. Verify the From domain first and inject a sending-only API key as a secret.
VENDURE_EMAIL_FROM="AwanMesh <noreply@moyaoai.com>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=replace-with-a-resend-sending-api-key

# Optional OpenTelemetry instrumentation. Production instrumentation requires all three values.
IS_INSTRUMENTED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp
OTEL_SERVICE_NAME=vendure-dev-server

# One-time empty-database bootstrap only. Do not enable during normal startup.
VENDURE_BOOTSTRAP_BASE_SCHEMA=false

# Public DNS target merchants point their CNAME or ALIAS records to.
STORE_DOMAIN_CNAME_TARGET=stores.moyaoai.com

# Production uses strict host-based routing for the AwanMesh and Meiyijia domains.
STORE_DOMAIN_ROUTING_MODE=require-domain

# Enable only when a trusted ingress always overwrites x-forwarded-host.
STORE_DOMAIN_TRUST_PROXY=false

# Hosts which retain token routing. Keep this empty in production unless the ingress blocks public access.
STORE_DOMAIN_BYPASS_HOSTS=localhost,127.0.0.1,vendure.localhost

# Optional one-click custom-domain routing and edge certificates through Cloudflare for SaaS.
# Leave manual unless all three Cloudflare values are configured in the runtime secret store.
STORE_DOMAIN_AUTOMATION_MODE=manual
CLOUDFLARE_SAAS_API_TOKEN=replace-with-a-scoped-cloudflare-api-token
CLOUDFLARE_SAAS_ZONE_ID=replace-with-the-saas-zone-id
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=damatong.net
# When true, the token also needs Zone:Read and DNS:Edit for customer zones in this account.
CLOUDFLARE_SAAS_AUTO_MANAGE_DNS=false
# Cloudflare-to-origin TLS/SNI is an evidence gate in READINESS_OPERATIONS_JSON,
# for example {"cloudflareOriginTls":true}; do not confirm it until a real custom hostname passes.

# Readiness audit only. Run separately with server, worker, and migration deployment environments.
READINESS_PROCESS_ROLE=server
READINESS_OPERATIONS_JSON=
