# Runtime and API
NODE_ENV=development
VENDURE_HOSTNAME=127.0.0.1
PORT=3000
# Set to 1 when Nginx is the only reverse proxy in front of Vendure.
VENDURE_TRUST_PROXY=false
VENDURE_SERVE_GRAPHIQL=true
VENDURE_SERVE_STATIC_DASHBOARD=true
VENDURE_DASHBOARD_URL=http://localhost:3000/dashboard
# Fallback for account emails when a Channel does not yet have a verified primary domain.
VENDURE_STOREFRONT_URL=http://127.0.0.1:5175
VENDURE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RUN_JOB_QUEUE=1
RUN_MIGRATIONS=true

# Authentication. Production startup requires non-empty values.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-password
COOKIE_SECRET=replace-with-a-long-random-secret

# Database. Development may use true; production must use false after initial creation.
DB=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=vendure-dev
DB_SYNCHRONIZE=true

# Persistent application data
VENDURE_ASSET_UPLOAD_DIR=./assets
VENDURE_IMPORT_ASSETS_DIR=./import-assets
VENDURE_EMAIL_OUTPUT_DIR=./test-emails

# One-time empty-database bootstrap only. Do not enable during normal startup.
VENDURE_BOOTSTRAP_BASE_SCHEMA=false

# Public DNS target merchants point their CNAME or ALIAS records to.
STORE_DOMAIN_CNAME_TARGET=stores.example.com

# Development may use prefer-domain. Production startup rejects anything except require-domain.
STORE_DOMAIN_ROUTING_MODE=prefer-domain

# Enable only when a trusted ingress always overwrites x-forwarded-host.
STORE_DOMAIN_TRUST_PROXY=false

# Hosts which retain token routing. Keep this empty in production unless the ingress blocks public access.
STORE_DOMAIN_BYPASS_HOSTS=localhost,127.0.0.1,vendure.localhost
