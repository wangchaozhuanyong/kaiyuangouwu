<mjml lang="{{ emailLanguage }}">
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-attributes>
            <mj-all font-family="Arial, 'Microsoft YaHei', sans-serif" />
            <mj-text color="#17212b" font-size="14px" line-height="1.7" />
            <mj-button background-color="#137c5b" color="#ffffff" border-radius="4px" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#f4f6f8">
        <mj-section background-color="#ffffff" padding="24px 28px 12px">
            <mj-column>
                <mj-text font-size="20px" font-weight="700" padding="0">{{ brandName }}</mj-text>
            </mj-column>
        </mj-section>
