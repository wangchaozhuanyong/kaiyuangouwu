{{#if isChinese}}
    {{> header title="订单确认" }}
{{else}}
    {{> header title="Order confirmation" }}
{{/if}}

<mj-section background-color="#ffffff" padding="12px 28px">
    <mj-column>
        {{#if isChinese}}
            <mj-text padding="0 0 8px">{{ order.customer.firstName }} {{ order.customer.lastName }}，您好：</mj-text>
            <mj-text padding="0">感谢您的购买，订单已经确认。</mj-text>
        {{else}}
            <mj-text padding="0 0 8px">Hello {{ order.customer.firstName }} {{ order.customer.lastName }},</mj-text>
            <mj-text padding="0">Thank you for your purchase. Your order is confirmed.</mj-text>
        {{/if}}
    </mj-column>
</mj-section>

<mj-section background-color="#eaf5f0" padding="18px 28px">
    <mj-column>
        <mj-text font-weight="700" padding="0 0 4px">{{#if isChinese}}订单号{{else}}Order number{{/if}}</mj-text>
        <mj-text padding="0">{{ order.code }}</mj-text>
    </mj-column>
    <mj-column>
        <mj-text font-weight="700" padding="0 0 4px">{{#if isChinese}}订单总额{{else}}Order total{{/if}}</mj-text>
        <mj-text padding="0">{{ formatMoney order.totalWithTax order.currencyCode emailLocale }}</mj-text>
    </mj-column>
</mj-section>

{{#if order.shippingAddress.streetLine1}}
<mj-section background-color="#ffffff" padding="20px 28px 8px">
    <mj-column>
        <mj-text font-size="17px" font-weight="700" padding="0 0 8px">{{#if isChinese}}收货地址{{else}}Shipping address{{/if}}</mj-text>
        <mj-text padding="0">
            {{ order.shippingAddress.fullName }}<br />
            {{ order.shippingAddress.province }} {{ order.shippingAddress.city }}
            {{ order.shippingAddress.streetLine1 }} {{ order.shippingAddress.streetLine2 }}<br />
            {{ order.shippingAddress.postalCode }} {{ order.shippingAddress.country }}<br />
            {{ order.shippingAddress.phoneNumber }}
        </mj-text>
    </mj-column>
</mj-section>
{{/if}}

<mj-section background-color="#ffffff" padding="12px 28px 20px">
    <mj-column>
        <mj-text font-size="17px" font-weight="700" padding="0 0 8px">{{#if isChinese}}订单明细{{else}}Order summary{{/if}}</mj-text>
        <mj-table cellpadding="7px" border="0">
            {{#each order.lines }}
                <tr style="border-bottom: 1px solid #e6eaed;">
                    <td>{{ productVariant.name }} × {{ quantity }}</td>
                    <td style="text-align: right;">{{ formatMoney discountedLinePriceWithTax ../order.currencyCode ../emailLocale }}</td>
                </tr>
            {{/each}}
            <tr>
                <td>{{#if isChinese}}商品小计{{else}}Subtotal{{/if}}</td>
                <td style="text-align: right;">{{ formatMoney order.subTotalWithTax order.currencyCode emailLocale }}</td>
            </tr>
            {{#each shippingLines }}
                <tr>
                    <td>{{#if ../isChinese}}配送费（{{ shippingMethod.name }}）{{else}}Shipping ({{ shippingMethod.name }}){{/if}}</td>
                    <td style="text-align: right;">{{ formatMoney priceWithTax ../order.currencyCode ../emailLocale }}</td>
                </tr>
            {{/each}}
            <tr style="font-weight: 700;">
                <td>{{#if isChinese}}合计{{else}}Total{{/if}}</td>
                <td style="text-align: right;">{{ formatMoney order.totalWithTax order.currencyCode emailLocale }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

{{> footer }}
