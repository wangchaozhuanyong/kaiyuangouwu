{{> header title="订单确认" }}

<mj-section background-color="#ffffff" padding="12px 28px">
    <mj-column>
        <mj-text padding="0 0 8px">{{ order.customer.firstName }} {{ order.customer.lastName }}，您好：</mj-text>
        <mj-text padding="0">感谢您的购买，订单已经确认。</mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="#eaf5f0" padding="18px 28px">
    <mj-column>
        <mj-text font-weight="700" padding="0 0 4px">订单号</mj-text>
        <mj-text padding="0">{{ order.code }}</mj-text>
    </mj-column>
    <mj-column>
        <mj-text font-weight="700" padding="0 0 4px">订单总额</mj-text>
        <mj-text padding="0">{{ formatMoney order.totalWithTax order.currencyCode 'zh-CN' }}</mj-text>
    </mj-column>
</mj-section>

{{#if order.shippingAddress.streetLine1}}
<mj-section background-color="#ffffff" padding="20px 28px 8px">
    <mj-column>
        <mj-text font-size="17px" font-weight="700" padding="0 0 8px">收货地址</mj-text>
        <mj-text padding="0">
            {{ order.shippingAddress.fullName }}<br />
            {{ order.shippingAddress.province }} {{ order.shippingAddress.city }}
            {{ order.shippingAddress.streetLine1 }} {{ order.shippingAddress.streetLine2 }}<br />
            {{ order.shippingAddress.postalCode }} {{ order.shippingAddress.country }}<br />
            {{ order.shippingAddress.phoneNumber }}
        </mj-text>
    </mj-column>
</mj-section>
{{/if}}

<mj-section background-color="#ffffff" padding="12px 28px 20px">
    <mj-column>
        <mj-text font-size="17px" font-weight="700" padding="0 0 8px">订单明细</mj-text>
        <mj-table cellpadding="7px" border="0">
            {{#each order.lines }}
                <tr style="border-bottom: 1px solid #e6eaed;">
                    <td>{{ productVariant.name }} × {{ quantity }}</td>
                    <td style="text-align: right;">{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'zh-CN' }}</td>
                </tr>
            {{/each}}
            <tr>
                <td>商品小计</td>
                <td style="text-align: right;">{{ formatMoney order.subTotalWithTax order.currencyCode 'zh-CN' }}</td>
            </tr>
            {{#each shippingLines }}
                <tr>
                    <td>配送费（{{ shippingMethod.name }}）</td>
                    <td style="text-align: right;">{{ formatMoney priceWithTax ../order.currencyCode 'zh-CN' }}</td>
                </tr>
            {{/each}}
            <tr style="font-weight: 700;">
                <td>合计</td>
                <td style="text-align: right;">{{ formatMoney order.totalWithTax order.currencyCode 'zh-CN' }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

{{> footer }}
