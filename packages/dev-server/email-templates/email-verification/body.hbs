{{#if isChinese}}
    {{> header title="验证电子邮箱" }}
{{else}}
    {{> header title="Verify your email address" }}
{{/if}}

<mj-section background-color="#ffffff" padding="16px 28px 24px">
    <mj-column>
        {{#if isChinese}}
            <mj-text padding="0 0 16px">感谢您注册 {{ brandName }}。请点击下方按钮验证电子邮箱并完成注册。</mj-text>
            <mj-button href="{{ verifyEmailAddressActionUrl }}">验证电子邮箱</mj-button>
            <mj-text color="#66727c" padding="16px 0 0">此链接将在 {{ accountTokenExpiryHours }} 小时后失效。</mj-text>
        {{else}}
            <mj-text padding="0 0 16px">Thank you for creating a {{ brandName }} account. Verify your email address to complete registration.</mj-text>
            <mj-button href="{{ verifyEmailAddressActionUrl }}">Verify email address</mj-button>
            <mj-text color="#66727c" padding="16px 0 0">This link expires in {{ accountTokenExpiryHours }} hours.</mj-text>
        {{/if}}
    </mj-column>
</mj-section>

{{> footer }}
