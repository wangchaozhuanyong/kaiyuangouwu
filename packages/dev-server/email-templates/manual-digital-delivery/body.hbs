{{#if isChinese}}
    {{> header title="数字商品领取通知" }}
{{else}}
    {{> header title="Digital delivery ready" }}
{{/if}}
<mj-section background-color="#ffffff"><mj-column>
    <mj-text font-size="20px" font-weight="bold">{{#if isChinese}}您的数字商品可以领取了{{else}}Your digital item is ready{{/if}}</mj-text>
    <mj-text>{{#if isChinese}}订单{{else}}Order{{/if}} {{orderCode}} · {{productName}}</mj-text>
    <mj-text>{{#if isChinese}}请在订单页点击领取，查看交付内容或下载文件。邮件发送结果不影响订单页领取资格。{{else}}Open the order and choose Claim to view your delivery or download its file. Email delivery does not affect access from your order.{{/if}}</mj-text>
    <mj-button href="{{receiptUrl}}">{{#if isChinese}}打开订单领取{{else}}Open order to claim{{/if}}</mj-button>
</mj-column></mj-section>
{{> footer }}
