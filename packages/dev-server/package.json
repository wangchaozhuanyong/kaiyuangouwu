{
    "name": "dev-server",
    "version": "3.7.2",
    "main": "index.js",
    "license": "GPL-3.0-or-later",
    "private": true,
    "//": "dev uses Portless for worktree-safe URLs; dev:agent adds machine-readable status/stop commands; dev:direct is the fixed-port escape hatch; workers are explicit and repository-locked.",
    "scripts": {
        "build:local-plugins": "bun run --cwd ../harden-plugin build && bun run --cwd ../content-translation-plugin build && bun run --cwd ../operations-dashboard-plugin build && bun run --cwd ../two-factor-dashboard-plugin build && bun run --cwd ../storefront-catalog-plugin build && bun run --cwd ../storefront-cart-plugin build && bun run --cwd ../storefront-review-plugin build && bun run --cwd ../store-domain-plugin build && bun run --cwd ../storefront-content-plugin build && bun run --cwd ../store-management-plugin build && bun run --cwd ../commerce-fulfillment-plugin build && bun run --cwd ../image-generation-plugin build",
        "populate": "node -r ts-node/register -r dotenv/config populate-dev-server.ts",
        "predev:server": "bun run build:local-plugins",
        "dev:server": "node ../cli/dist/cli.js dev server --server-entry ./index.ts",
        "dev:server:instrumented": "IS_INSTRUMENTED=true node -r ts-node/register -r dotenv/config -r tsconfig-paths/register -r ./instrumentation.ts index.ts",
        "predev:worker": "bun run build:local-plugins",
        "dev:worker": "node ./scripts/run-worker.mjs",
        "dev:worker:instrumented": "node ./scripts/run-worker.mjs --instrumented",
        "dev": "node ./scripts/dev-workflow.mjs portless",
        "dev:agent": "node ./scripts/dev-workflow.mjs portless --agent",
        "dev:status": "node ./scripts/dev-status.mjs",
        "dev:stop": "node ./scripts/dev-stop.mjs",
        "dev:direct": "node ./scripts/dev-workflow.mjs direct",
        "dev:instrumented": "concurrently npm:dev:server:instrumented npm:dev:worker:instrumented",
        "dashboard:dev": "node ../cli/dist/cli.js dev dashboard",
        "test:dev-workflow": "node --test ./scripts/*.spec.mjs",
        "test:migrations": "vitest run --config vitest.config.mts",
        "seed:storefront-demo": "node ./scripts/seed-storefront-demo.mjs --apply",
        "sync:storefront-media": "node ./scripts/sync-storefront-media.mjs",
        "repair:inventory-inheritance": "node ./scripts/repair-inventory-inheritance.mjs",
        "audit:storefront-readiness": "node ./scripts/storefront-readiness.mjs",
        "audit:production-env": "node ./scripts/production-env-readiness.mjs",
        "build:production-runtime": "node ./scripts/production-runtime-artifact.mjs",
        "test:order-note:e2e": "node ./scripts/order-note-e2e.mjs",
        "test:storefront-content:e2e": "node ./scripts/storefront-content-e2e.mjs",
        "prebuild": "bun run build:local-plugins",
        "build": "node ../cli/dist/cli.js build all",
        "prebuild:server": "bun run build:local-plugins",
        "build:server": "node ../cli/dist/cli.js build server",
        "prebuild:worker": "bun run build:local-plugins",
        "build:worker": "node ../cli/dist/cli.js build worker",
        "build:dashboard": "node ../cli/dist/cli.js build dashboard",
        "start": "node ../cli/dist/cli.js start all",
        "start:server": "node ../cli/dist/cli.js start server",
        "start:worker": "node ../cli/dist/cli.js start worker",
        "load-test:1k": "node -r ts-node/register load-testing/run-load-test.ts 1000",
        "load-test:10k": "node -r ts-node/register load-testing/run-load-test.ts 10000",
        "load-test:100k": "node -r ts-node/register load-testing/run-load-test.ts 100000"
    },
    "dependencies": {
        "@nestjs/axios": "^4.0.0",
        "@vendure/asset-server-plugin": "3.7.2",
        "@vendure/common": "3.7.2",
        "@vendure/content-translation-plugin": "0.1.0",
        "@vendure/commerce-fulfillment-plugin": "0.1.0",
        "@vendure/core": "3.7.2",
        "@vendure/dashboard": "3.7.2",
        "@vendure/email-plugin": "3.7.2",
        "@vendure/harden-plugin": "3.7.2",
        "@vendure/image-generation-plugin": "0.1.0",
        "@vendure/operations-dashboard-plugin": "0.1.0",
        "@vendure/two-factor-dashboard-plugin": "0.1.0",
        "@vendure/store-management-plugin": "0.1.0",
        "@vendure/storefront-catalog-plugin": "0.1.0",
        "@vendure/storefront-content-plugin": "0.1.0",
        "@vendure/storefront-cart-plugin": "0.1.0",
        "@vendure/storefront-review-plugin": "0.1.0",
        "@vendure/store-domain-plugin": "0.1.0",
        "dotenv": "^16.6.1"
    },
    "devDependencies": {
        "@typescript/native-preview": "7.0.0-dev.20260515.1",
        "@vendure/cli": "3.7.2",
        "@vendure/testing": "3.7.2",
        "@vendure/ui-devkit": "3.7.2",
        "commander": "^12.0.0",
        "concurrently": "^9.2.0",
        "csv-stringify": "^6.4.6",
        "dayjs": "^1.11.10",
        "jsdom": "^26.0.0",
        "portless": "0.13.0",
        "progress": "^2.0.3",
        "semver": "^7.7.4",
        "tsconfig-paths": "^4.2.0",
        "typescript": "5.8.2"
    }
}
