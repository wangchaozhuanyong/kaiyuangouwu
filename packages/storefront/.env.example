VITE_SHOP_API_URL=/shop-api
# Local Vite proxy target. The direct Vendure development workflow uses port 3000.
VITE_SHOP_API_PROXY_TARGET=http://127.0.0.1:3000
# Only list markets whose Vendure Channels, countries, prices, shipping and domains are configured.
VITE_MARKET_CODES=cn-mainland,my-malaysia
# Production uses verified host-based Channel routing. See .env.production.
VITE_CLIENT_CHANNEL_SWITCHING=false

# Optional isolated 2FA frontend. Deploy dist-two-factor on its own HTTPS origin, then enable.
# Keep blank until its CSP, allowed parent origins, storage and migration have been verified.
VITE_TWO_FACTOR_ORIGIN=
# Exact HTTPS storefront origins, comma separated; never use wildcards. Used only by the isolated build.
VITE_TWO_FACTOR_PARENT_ORIGINS=
