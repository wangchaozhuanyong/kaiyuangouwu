VITE_SHOP_API_URL=/shop-api
# Local Vite proxy target. The direct Vendure development workflow uses port 3000.
VITE_SHOP_API_PROXY_TARGET=http://127.0.0.1:3000
# Only list markets whose Vendure Channels, countries, prices, shipping and domains are configured.
VITE_STOREFRONT_MARKETS=cn-mainland
# Production storefronts let the verified request domain choose the Vendure Channel.
VITE_CLIENT_CHANNEL_SWITCHING=false
